pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-key')
        AWS_DEFAULT_REGION    = 'ap-northeast-1'

        ECR_REGISTRY = '177603749127.dkr.ecr.ap-northeast-1.amazonaws.com'
        ECR_REPO     = 'cbz/00'

        APP1_TAG = 'v1'
        APP2_TAG = 'v2'

        CLUSTER_NAME = 'my-cluster-via-jenkins'
    }

    parameters {
        choice(name: 'ACTION', choices: ['v1','v2','rollback-v1'], description: 'Choose website version Action wisely')
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/bhagwatborde76-sys/jenkins-rollback-rollupdate.git'
            }
        }

        stage('Validate ECR Repo Exists') {
            steps {
                sh '''
                aws ecr describe-repositories \
                  --repository-names ${ECR_REPO} \
                  --region ${AWS_DEFAULT_REGION}
                '''
            }
        }

        stage('Install kubectl') {
            steps {
                sh '''
                    set -e
                    KUBECTL_VERSION=$(curl -Ls https://dl.k8s.io/release/stable.txt)
                    if [ -z "$KUBECTL_VERSION" ]; then
                      KUBECTL_VERSION="v1.28.3"
                    fi
                    curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl"
                    chmod +x kubectl
                    sudo mv kubectl /usr/local/bin/
                    kubectl version --client
                '''
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region ${AWS_DEFAULT_REGION} \
                | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Build & Push App1 Image (v1)') {
            steps {
                sh '''
                docker build -t ${ECR_REPO}:${APP1_TAG} .
                docker tag ${ECR_REPO}:${APP1_TAG} \
                  ${ECR_REGISTRY}/${ECR_REPO}:${APP1_TAG}
                docker push ${ECR_REGISTRY}/${ECR_REPO}:${APP1_TAG}
                '''
            }
        }

        stage('Build & Push App2 Image (v2)') {
            steps {
                dir('app2') {
                    sh '''
                    docker build -t ${ECR_REPO}:${APP2_TAG} .
                    docker tag ${ECR_REPO}:${APP2_TAG} \
                      ${ECR_REGISTRY}/${ECR_REPO}:${APP2_TAG}
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:${APP2_TAG}
                    '''
                }
            }
        }

        stage('Connect to EKS') {
            steps {
                sh '''
                aws eks update-kubeconfig \
                  --name ${CLUSTER_NAME} \
                  --region ${AWS_DEFAULT_REGION}
                '''
            }
        }

        stage('Deploy App1 (Rolling + Rollback)') {
            steps {
                script {
                    if (params.ACTION == 'v1') {
                        sh 'kubectl apply -f deployment.yaml'
                        sh 'kubectl apply -f app1-svc.yaml'
                    } else if (params.ACTION == 'v2') {
                        sh "kubectl set image deployment/cbz-deployment cbz-app1=${ECR_REGISTRY}/${ECR_REPO}:${APP2_TAG}"
                    } else if (params.ACTION == 'rollback-v1') {
                        sh 'kubectl rollout undo deployment/cbz-deployment'
                    }

                  /*  try {
                        sh 'kubectl rollout status deployment/cbz-deployment --timeout=180s'
                    } catch (Exception e) {
                        echo '❌ App1 rollout failed → rolling back'
                        sh 'kubectl rollout undo deployment/cbz-deployment || true'
                        error 'App1 deployment failed'
                    }
                    */
                }
            }
        }

      /* stage('Deploy App2 (Rolling + Rollback)') {
            steps {
                script {
                    sh 'kubectl apply -f app2/deployment.yaml'
                    sh 'kubectl apply -f app2/app-2-svc.yaml'

                    try {
                        sh 'kubectl rollout status deployment/my-deployment-app2 --timeout=180s'
                    } catch (Exception e) {
                        echo '❌ App2 rollout failed → rolling back'
                        sh 'kubectl rollout undo deployment/my-deployment-app2 || true'
                        error 'App2 deployment failed'
                    }
                }
            }
        }
        */
    }


    post {
        success {
            echo '🎉 SUCCESS: Pipeline completed with rolling updates'
        }
        failure {
            echo '❌ PIPELINE FAILED — AUTO ROLLBACK EXECUTED'
        }
    }
}
